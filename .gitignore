# Generated BEHAVIOR data and runtime output. None of these are source.
examples/behavior/data/
examples/behavior/runs/
/runs/

# Root Pixi owns only the shared planner environment. BEHAVIOR is managed by
# the official Conda setup and stored at this ignored prefix.
/.pixi/
/examples/behavior/.pixi/
/examples/behavior/.conda/

# Python and editor by-products.
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.vscode/
.idea/

# Do not accidentally commit licensed BEHAVIOR assets if an upstream default path is used.
third_party/BEHAVIOR-1K/datasets/
